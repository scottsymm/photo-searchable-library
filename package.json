{
  "name": "photo-searchable-library",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "bridge:build": "swift build --package-path apps/photos-bridge",
    "bridge:dry-run": "swift run --package-path apps/photos-bridge PicsPhotosBridge --dry-run --limit 25",
    "bridge:sync": "swift run --package-path apps/photos-bridge PicsPhotosBridge --limit 25",
    "bridge:watch": "swift run --package-path apps/photos-bridge PicsPhotosBridge --watch --poll-interval 5",
    "dev": "turbo run dev --filter=web --parallel",
    "dev:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build --watch",
    "dev:docker:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "test": "turbo run test --filter=web --filter=pics-api --filter=pics-cli --filter=pics-core --filter=pics-worker",
    "build": "turbo run build --filter=web --filter=pics-api --filter=pics-cli --filter=pics-core --filter=pics-worker",
    "check": "turbo run check --filter=pics --filter=web"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
